# Copie este arquivo para .env e ajuste se necessário.
# Os defaults batem com o docker-compose.yml local.

# --- MinIO (Bronze) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=librarian-bronze
MINIO_SECURE=False

# --- PostgreSQL (Ouro - texto) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=librarian
POSTGRES_PASSWORD=librarian
POSTGRES_DB=librarian

# --- Qdrant (Ouro - vetores) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=librarian_chunks

# --- arXiv ---
ARXIV_DEFAULT_N=5
ARXIV_REQUEST_DELAY_SECONDS=3.0

# --- Agente Agno (aplicação externa) ---
# Chave da API do Groq. Sem ela o agente sobe mas não responde.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Database próprio do agente no mesmo servidor Postgres. Criar uma vez com:
#   docker exec librarian_postgres psql -U librarian -c "CREATE DATABASE agno"
POSTGRES_DB_AGNO=agno
